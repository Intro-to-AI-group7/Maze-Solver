# Maze Solver experiment-suite example
# This is a human-readable Java-properties file with the .mstests extension.
# It contains two test rows:
#   row.0 uses the embedded weighted saved map and runs 10 iterations.
#   row.1 generates reproducible maps from its persisted manual seed.
# Each selected algorithm receives the same map for a given iteration.
# The row.0.savedMap value is Base64-encoded .msmap text so the original
# source map file is not required when this suite is loaded.
# The row.0.savedMapName value is display metadata only.
# Values such as dimensions, costs, endpoints, and seed are ignored for
# saved-map rows when the embedded map already defines those properties.
#Sat Oct 10 00:13:27 EDT 2026
automaticExport=false
exportDirectory=
format=maze-solver-test-suite
applicationVersion=0.7
name=experiment-suite
row.0.algorithms=UCS,GREEDY,A_STAR
row.0.blockedPercent=25.0
row.0.columns=100
row.0.costMode=RANDOM
row.0.distanceTolerance=1
row.0.endpointMode=RANDOM
row.0.goalColumn=18
row.0.goalRow=18
row.0.id=test-1
row.0.iterations=10
row.0.mapSource=SAVED_MAP
row.0.maximumCost=5
row.0.minimumCost=1
row.0.reachability=GUARANTEED_SOLVABLE
row.0.rows=100
row.0.sameCostBothDirections=true
row.0.\=
row.0.savedMapName=test_weighted_100x100.msmap
row.0.seed=0
row.0.startColumn=1
row.0.startRow=1
row.0.targetDistance=34
row.1.algorithms=UCS,GREEDY,A_STAR
row.1.blockedPercent=25.0
row.1.columns=100
row.1.costMode=RANDOM
row.1.distanceTolerance=1
row.1.endpointMode=RANDOM
row.1.goalColumn=18
row.1.goalRow=18
row.1.id=test-2
row.1.iterations=10
row.1.mapSource=MANUAL_SEED
row.1.maximumCost=5
row.1.minimumCost=1
row.1.reachability=GUARANTEED_SOLVABLE
row.1.rows=100
row.1.sameCostBothDirections=true
row.1.seed=-3422292195023417271
row.1.startColumn=1
row.1.startRow=1
row.1.targetDistance=34
rowCount=2
version=1
